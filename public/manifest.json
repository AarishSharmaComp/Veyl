{
  "manifest_version": 3,
  "name": "Veyl — Live Camera Effects",
  "short_name": "Veyl",
  "version": "0.1.0",
  "description": "Present, not visible. Local camera effects for websites you choose.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["https://meet.google.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "icons": {
    "16": "icons/veyl-16.png",
    "32": "icons/veyl-32.png",
    "48": "icons/veyl-48.png",
    "128": "icons/veyl-128.png"
  },
  "action": {
    "default_title": "Veyl",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/veyl-16.png",
      "32": "icons/veyl-32.png",
      "48": "icons/veyl-48.png",
      "128": "icons/veyl-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-disappearance": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Toggle Veyl camera effects in the active enabled tab"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["models/*", "wasm/*", "hand-gesture-worker.js", "face-landmarker-worker.js"],
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: blob:"
  }
}
