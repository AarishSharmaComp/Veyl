{
  "name": "veyl-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first camera effects for user-selected websites",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:hand-lab": "node scripts/hand-inference-lab.mjs",
    "test:gesture-lab": "node scripts/gesture-lab.mjs",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.22"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  }
}
